# NOXCAT: FEEL NOTHING — environment example
#
# Copy this file before starting the server:
#   cp .env.example .env
#
# Never commit `.env` or place a real API key in frontend code. All variables
# below are read by the Node.js server unless explicitly noted otherwise.

# -----------------------------------------------------------------------------
# AI provider — Ollama on the same server
# -----------------------------------------------------------------------------
# The server must support POST /v1/chat/completions and
# response_format.type=json_schema.
#
# Ollama exposes an OpenAI-compatible API on port 11434 by default.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Use the exact model identifier exposed by the local server.
# Pull this model first with: ollama pull gemma3:4b
OPENAI_MODEL=gemma3:4b

# Most local servers ignore authentication. A placeholder is safe to use when
# the SDK requires a non-empty key; replace it if your server requires a token.
OPENAI_API_KEY=local-ollama

# -----------------------------------------------------------------------------
# OpenAI cloud alternative
# -----------------------------------------------------------------------------
# To use OpenAI instead, replace the three values above with values like these:
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# Prompt and timeout
# -----------------------------------------------------------------------------
# This instruction is prepended to the built-in safety prompt. The server still
# validates every response, converts player-facing text to Taiwan Traditional
# Chinese, and falls back locally when output is invalid.
OPENAI_INITIAL_PROMPT="Always use zh-Hant-TW Traditional Chinese for every player-facing text field. Never output Simplified Chinese. Keep every line witty, concise, and clearly related to the user's annoyance."

# Timeout for each AI batch in milliseconds. The game generates two batches of
# six battle lines. Keep this below the browser request timeout (6000 ms).
OPENAI_TIMEOUT_MS=5500

# -----------------------------------------------------------------------------
# Web server
# -----------------------------------------------------------------------------
PORT=4173

# Enable only when Express runs behind a trusted reverse proxy. Typical value:
# TRUST_PROXY=1

# Optional: base URL used only by the screenshot capture script.
# NOXCAT_BASE_URL=http://127.0.0.1:4173
