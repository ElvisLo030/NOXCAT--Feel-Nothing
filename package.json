{
  "name": "noxcat-feel-nothing",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE-SCOPE.md",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js --production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "fetch:face-model": "node scripts/fetch-face-model.mjs",
    "copy:mediapipe": "node scripts/copy-mediapipe-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "express": "^5.1.0",
    "openai": "^5.23.2",
    "phaser": "3.90.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
